[Unit]
Description=zara static web page (served to Cloudflare Tunnel on localhost)
After=network.target

[Service]
DynamicUser=yes
ExecStart=/usr/bin/python3 -m http.server 8081 --bind 127.0.0.1 --directory /var/www/zara
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
