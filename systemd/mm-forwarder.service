[Unit]
Description=Mattermost -> Telegram forwarder (with reply-back)
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=mm-forwarder
EnvironmentFile=/etc/zara-assistant/env
ExecStart=/usr/bin/python3 -u /opt/zara-assistant/mm_forwarder.py
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
