[Unit]
Description=Claude Code Remote Control as the bot user (zara-bot)
After=network-online.target
Wants=network-online.target

[Service]
User=assistant
WorkingDirectory=/home/assistant/assistant
Environment=HOME=/home/assistant
ExecStart=/home/assistant/.local/bin/claude remote-control --name zara-bot
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
