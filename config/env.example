# non-secret, site-specific settings
KUBE_CONTEXTS=
BRIEFING_CONTEXTS=
GITLAB_HOST=
GITLAB_USER=
GRAFANA_PROD_URL=
GRAFANA_DEV_URL=

# model for the quick alert call/no-call verdict (investigations use the default model)
#TRIAGE_MODEL=haiku
# minutes an investigation stays open in the Claude app after it answers
#INVESTIGATE_KEEP_MIN=60
# model for investigations (pinned so a plan default change does not switch it)
#INVESTIGATE_MODEL=opus

# task list (zara-tasks service). TASKS_TOKEN: random secret shared by the bot, forwarder and CLI,
# create on zara with: echo "TASKS_TOKEN=$(openssl rand -hex 32)" >> /etc/zara-assistant/env
TASKS_TOKEN=
# address your browser uses for the task page (LAN), e.g. http://zara.local:8082
TASKS_URL=
#TASKS_PORT=8082
# model that turns a message into a task (title, notes, priority, due date)
#TASKS_MODEL=sonnet
